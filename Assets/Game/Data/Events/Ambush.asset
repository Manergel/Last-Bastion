  m_Name: Ambush
  m_EditorClassIdentifier: Assembly-CSharp::EventData
  eventTitle: Ambush
  eventDescription: "\u041E\u0442\u0440\u044F\u0434 \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0443\u043F\u043F\u0443 \u043E\u0434\u0435\u0440\u0436\u0438\u043C\u044B\u0445.
    \n\u041E\u043D\u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442 \u043F\u0443\u0442\u044C
    \u0432\u043F\u0435\u0440\u0451\u0434."
  choices:
  - choiceText: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u0431\u043E\u0435\u043C"
    successText: "\u041E\u0442\u0440\u044F\u0434 \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0442\u0435\u0440\u044C \u043D\u0435\u0442"
    failureText: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u043E\u0439 \u2014
      \u043E\u0434\u0438\u043D \u0440\u0430\u043D\u0435\u043D."
    baseSuccessChance: 60
    goldReward: 30
    canCauseDeath: 1
  - choiceText: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0440\u0443\u0438\u043D\u044B"
    successText: "\u0422\u0438\u0445\u043E \u043E\u0431\u043E\u0448\u043B\u0438,
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B."
    failureText: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0438\u0441\u044C,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F."
    baseSuccessChance: 75
    goldReward: 10
    canCauseDeath: 0
